{
  "name": "forgecrew",
  "version": "0.0.0",
  "private": true,
  "description": "Turns issues into reviewed, merged changes, with each delivery role acting as its own forge identity.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm deps",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "typecheck": "tsc",
    "test": "vitest run",
    "deps": "depcruise src --config"
  },
  "dependencies": {
    "@octokit/app": "16.1.4",
    "@octokit/rest": "22.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "18.5.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.3"
  }
}
